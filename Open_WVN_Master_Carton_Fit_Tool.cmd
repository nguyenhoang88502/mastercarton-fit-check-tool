powershell -NoProfile -ExecutionPolicy Bypass -Command "$tool=(Resolve-Path -LiteralPath '%~dp0').Path; $parent=Split-Path -Parent $tool; $sibling=Join-Path $parent '1. Weekly BOM'; $local=Join-Path $tool '1. Weekly BOM'; $dir=if(Test-Path -LiteralPath $sibling){$sibling}else{$local}; $prefix=if($dir -eq $sibling){'../1. Weekly BOM/'}else{'1. Weekly BOM/'}; $files=@(); if(Test-Path -LiteralPath $dir){$files=Get-ChildItem -LiteralPath $dir -Filter *.xlsx -File | Where-Object {$_.Name -notlike '~$*'} | Sort-Object LastWriteTimeUtc -Descending | ForEach-Object {[pscustomobject]@{path=($prefix + $_.Name); name=$_.Name; modifiedUtc=$_.LastWriteTimeUtc.ToString('o')}}}; $json=ConvertTo-Json -Compress -Depth 3 -InputObject @($files); Set-Content -Encoding UTF8 -LiteralPath (Join-Path $tool 'Weekly BOM Manifest.json') -Value $json; $p=@('Products Physical Dimension - FG 1.Apr.25.xlsx', '*Products Physical Dimension - FG *.xlsx', '*Products Physical Dimension*.xlsx', '*Physical Dimension*.xlsx', '*Dimension*FG*.xlsx', 'carton_tool_input.xlsx'); $df=$null; foreach($d in @($dir, $tool)){ if(Test-Path -LiteralPath $d){ foreach($pat in $p){ $df=Get-ChildItem -LiteralPath $d -Filter $pat -File | Where-Object {$_.Name -notlike '~$*'} | Sort-Object LastWriteTimeUtc -Descending | Select-Object -First 1; if($df){break} } } if($df){break} }; $dims=@(); if($df){ $dp=if($df.DirectoryName -eq $sibling){'../1. Weekly BOM/'}elseif($df.DirectoryName -eq $local){'1. Weekly BOM/'}else{''}; $dims+=[pscustomobject]@{name=$df.Name; path=($dp+$df.Name); url=([System.Uri]$df.FullName).AbsoluteUri; modifiedUtc=$df.LastWriteTimeUtc.ToString('o'); sourceType='dimension'} }; $jsonDim=ConvertTo-Json -Compress -Depth 3 -InputObject @($dims); Set-Content -Encoding UTF8 -LiteralPath (Join-Path $tool 'WVN Master Carton Workbook Manifest.json') -Value $jsonDim" & start "" "%ProgramFiles%\Google\Chrome\Application\chrome.exe" --user-data-dir="%TEMP%\WVNMasterCartonToolChrome-%RANDOM%" --allow-file-access-from-files "%~dp0WVN_Master_Carton_Fit_Tool.html"